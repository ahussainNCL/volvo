{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "e2e"]
}
